{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-shell",
  "version": "0.1.0",
  "identifier": "app.dsh.shell",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.dsh.example.com/dsh-shell/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "PLACEHOLDER-REPLACE-WITH-REAL-MINISIGN-PUBLIC-KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
