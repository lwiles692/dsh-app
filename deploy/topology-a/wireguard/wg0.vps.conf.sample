# 形态 A · WireGuard 隧道 —— VPS 侧（/etc/wireguard/wg0.conf）
#
# 拓扑：VPS(10.9.0.1) <==加密隧道==> 开发机(10.9.0.2)
# 隧道只承载一个流：VPS 回环 127.0.0.1:3080 <-> 开发机回环 127.0.0.1:3080（dsh Host）。
# dsh Host 有意不支持绑定非回环地址（上游安全设计），故两端各跑一个本地转发器
# 把隧道流量折返回环（见 RUNBOOK 形态 A 章节的 socat 命令）：
#   网关 -> VPS socat(127.0.0.1:3080) -> wg -> 开发机 socat(10.9.0.2:3080) -> dsh Host(127.0.0.1:3080)
#
# 密钥生成（两端各自执行，私钥不出本机）：
#   wg genkey | tee privatekey | wg pubkey > publickey

[Interface]
Address = 10.9.0.1/24
ListenPort = 51820
PrivateKey = <VPS 私钥>
# 隧道不转发公网流量，无需 NAT/转发规则；防火墙仅放行 UDP 51820

[Peer]
# 开发机
PublicKey = <开发机公钥>
AllowedIPs = 10.9.0.2/32
